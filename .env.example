# ============================================================
# Harvey environment variables
# Copy this file to .env and fill in your values:  cp .env.example .env
# Never commit .env — it is gitignored.
# Pick ONE email provider below (set channels.email.provider in harvey.yaml
# to match): gmail (recommended), smtp, or instantly. Everything else is
# optional but an email verifier (Reoon/ZeroBounce) is strongly recommended.
# ============================================================

# ------------------------------------------------------------
# EMAIL PROVIDER — how Harvey sends and reads replies. Choose one.
#
# Option A: Gmail / Google Workspace  [RECOMMENDED for <50 cold/day]
#   Set provider: gmail in harvey.yaml. Use a mailbox on a DEDICATED
#   secondary domain (never your main one), with SPF/DKIM/DMARC set up.
#   1. Google Cloud Console → new project → enable the Gmail API
#   2. Credentials → OAuth client ID → type "Desktop app"
#   3. Paste the client id/secret below, then run: harvey gmail auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Option B: Any SMTP + IMAP mailbox  [AgentMail, Fastmail, Workspace app pw]
#   Set provider: smtp in harvey.yaml. IMAP_* defaults to the SMTP_* values.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Option B2: Microsoft 365 / Outlook  [for a mailbox on Exchange Online]
#   Set provider: microsoft in harvey.yaml. Exchange Online no longer
#   accepts passwords over IMAP, so this signs in with OAuth instead:
#   1. entra.microsoft.com → App registrations → New registration
#      ("this organizational directory only"; redirect URI platform
#      "Public client/native", value http://localhost:8766)
#   2. Paste the Application (client) ID and Directory (tenant) ID below
#   3. Run: harvey microsoft auth   (then: harvey microsoft test)
M365_CLIENT_ID=
M365_TENANT_ID=

# Option C: Instantly — cold email platform  [legacy]
# Where to get it: https://app.instantly.ai → Settings → Integrations → API Keys
# API access requires Instantly's Growth plan or higher.
INSTANTLY_API_KEY=

# ------------------------------------------------------------
# LinkedIn — browser-automation prospecting  [OPTIONAL]
# These are the credentials of the LinkedIn account Harvey will log into
# with Playwright. WARNING: automation violates LinkedIn's Terms of Service
# and can get the account restricted or banned. Use a account you can
# afford to lose, keep the default rate limits, or leave blank to skip —
# Harvey will prospect via web search and company websites instead.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ------------------------------------------------------------
# Cloudflare Browser Rendering — deep website crawling during training  [OPTIONAL]
# Enables JS-rendered crawling of your own site when running `harvey train`.
# Where to get it:
#   Account ID: https://dash.cloudflare.com → right sidebar of any zone, or the URL
#   API Token:  https://dash.cloudflare.com/profile/api-tokens → Create Token
#               → grant "Browser Rendering: Edit" permission
# Cost: ~$5/mo on the paid Workers plan (~12,000 pages). Free tier has limits.
# Without these, Harvey uses its built-in HTTP crawler (no JS rendering).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ------------------------------------------------------------
# Email verification — how Harvey confirms a prospect's address really
# exists before sending. Harvey learns each company's email PATTERN, then
# verifies ONE candidate (raw SMTP probing no longer works against Google
# Workspace / Microsoft 365). Any ONE of these keys is enough; add more for
# best coverage. Without any, addresses are marked "guess" and never sent.

# Reoon — best free tier for cold-email verification (600 checks/month,
# renews monthly + 100 non-expiring). Good catch-all flagging.
# Where to get it: https://reoon.com/email-verifier → sign up → API
REOON_API_KEY=

# ZeroBounce — 100 free/month. Its 2026 engine is the reliable one for
# Microsoft 365 / Google Workspace catch-all domains; Harvey routes those
# domains here specifically. https://zerobounce.net → API
ZEROBOUNCE_API_KEY=

# Hunter.io — email discovery + pattern lookup  [OPTIONAL]
# Free tier: 50 verifications + 25 domain-searches/month. Its domain-search
# is the cheapest way to learn a company's email pattern (used first, so
# Harvey verifies one address instead of guessing six).
# Where to get it: https://hunter.io → sign up → API → API Keys
HUNTER_API_KEY=
# Domain-searches per month across all of Harvey. 25 matches Hunter's free
# tier; set this to your plan's allowance if you pay for Hunter.
HUNTER_MONTHLY_SEARCHES=25

# More free tiers, tried after the ones above when those can't decide.
# Harvey counts every check it makes to each one per calendar month and
# stops using it once the *_MONTHLY_CHECKS allowance is used, so the free
# tier is never exceeded (set the allowance to your plan's if you pay).
# Bounceless: 1,000 free/month; signing up needs a work email. https://bounceless.io
BOUNCELESS_API_KEY=
BOUNCELESS_MONTHLY_CHECKS=1000
# EmailVerify.io: 100 free/month. https://emailverify.io
EMAILVERIFY_API_KEY=
EMAILVERIFY_MONTHLY_CHECKS=100
# GetProspect: 100 free verifications/month. https://getprospect.com
GETPROSPECT_API_KEY=
GETPROSPECT_MONTHLY_CHECKS=100
# Abstract (an Email Reputation key, or an older Email Validation key): 100 free/month, about one request a second. https://www.abstractapi.com
ABSTRACT_API_KEY=
ABSTRACT_MONTHLY_CHECKS=100
# MailboxValidator: 300 free/month. https://www.mailboxvalidator.com
MAILBOXVALIDATOR_API_KEY=
MAILBOXVALIDATOR_MONTHLY_CHECKS=300
# Sniffmail: 500 free/month, 10 a minute (Harvey spaces its calls). https://sniffmail.io
SNIFFMAIL_API_KEY=
SNIFFMAIL_MONTHLY_CHECKS=500
# emailvalidation.io: 100 free/month, 10 a minute (Harvey spaces its calls). https://emailvalidation.io
EMAILVALIDATIONIO_API_KEY=
EMAILVALIDATIONIO_MONTHLY_CHECKS=100
# BounceZero: 100 free/month. https://bouncezero.io
BOUNCEZERO_API_KEY=
BOUNCEZERO_MONTHLY_CHECKS=100
# MyEmailVerifier: its pricing page says 100 free credits a day, its FAQ a
# one-time 100, so Harvey assumes 100 in all. If the daily credits prove
# real, set MYEMAILVERIFIER_DAILY_CHECKS=100 and MYEMAILVERIFIER_MONTHLY_CHECKS=3000.
# https://myemailverifier.com
MYEMAILVERIFIER_API_KEY=
MYEMAILVERIFIER_MONTHLY_CHECKS=100
# Any of these can also have a daily allowance: <SERVICE>_DAILY_CHECKS
# (e.g. SNIFFMAIL_DAILY_CHECKS=20). Unset or 0 means no daily cap. When one
# is set, Harvey counts that verifier per UTC day too and stops at whichever
# of the daily and monthly allowances runs out first.

# Precleared — per-recipient cold-email compliance check  [OPTIONAL]
# Only used when compliance.precleared.enabled is true in harvey.yaml.
# Without a key: 10 checks a day. Free key: 25 a day. Paid packs beyond that.
# Where to get it: https://precleared.dev/get-key
PRECLEARED_API_KEY=

# TrulyInbox — warmup service (recommended)  [OPTIONAL]
# Lets `harvey warmup` read whether your mailbox is actually warmed.
# Easiest: run `harvey trulyinbox connect`, which checks the key and fills these in.
# Get TrulyInbox: https://trulyinbox.com/?via=harvey  (API access starts on Starter)
TRULYINBOX_API_KEY=
TRULYINBOX_WORKSPACE_ID=

# ------------------------------------------------------------
# DISCOVERY — where Harvey finds businesses.  [ALL OPTIONAL]
# The default source (OpenStreetMap) needs no account at all:
#     harvey discover
# See every option, with real prices, via:
#     harvey discover --providers      (or the dashboard's Discover tab)
# ------------------------------------------------------------

# DataForSEO — cheapest local-business and SERP data anywhere.
# Where to get it: https://app.dataforseo.com/api-access
#   NOTE: the API password is auto-generated there. It is NOT your account
#   password. $1 free credit on signup; $50 minimum deposit to go live.
# Cost: $0.372 per 1,000 businesses; $0.006 per depth-30 organic search and
# $0.002 per Maps search (Live endpoints).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Set to any value to route every call to DataForSEO's free sandbox. Same
# response shape, dummy data, never charged — the right way to try it.
DATAFORSEO_SANDBOX=

# Serper.dev — Google Search API, used for discovery and for Scout's searches.
# Where to get it: https://serper.dev → sign up → Dashboard → API Key
# Cost: 2,500 queries free with no card, then a $50 prepaid pack (credits
# expire after 6 months). Without it Harvey falls back to DuckDuckGo/Bing
# scraping, which is heavily rate-limited.
SERPER_API_KEY=

# Scavio — Google Maps listings and Google Search from one key.
# Where to get it: https://scavio.dev → sign up → Dashboard → API Keys
# Cost: 50 credits free on signup, no card. Then $30/mo for 7,000 credits.
# Each page costs 1 credit (up to 20 Maps or 10 Search results). Estimates
# use the $0.01 pay-as-you-go price; subscriptions can cost less.
# Pick scavio_maps or scavio_search in `harvey discover`.
SCAVIO_API_KEY=

# TinyFish — web search for discovery and Scout. Records no search rank.
# Where to get it: https://agent.tinyfish.ai/api-keys
# Cost: free, no card. Limits: 30 searches a minute, 500 an hour.
TINYFISH_API_KEY=

# ------------------------------------------------------------
# Calendly — meeting auto-booking  [NOT YET USED — roadmap]
# CALENDLY_API_KEY=
